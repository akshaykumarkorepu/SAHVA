function CallDemo() {
  const [step, setStep] = React.useState(0);
  const [isSpeaking, setIsSpeaking] = React.useState(false);

  const conversation = [
    { side: "left" as const, text: "నమస్తే, శ్రీ సాయి క్లినిక్. నేను మాయ. మీకు ఎలా సహాయం చేయగలను?", lang: "te", delay: 2500 },
    { side: "right" as const, text: "డాక్టర్ అనిత గారిని కలవాలి", lang: "te", delay: 2000 },
    { side: "left" as const, text: "రేపు ఉదయం 10:00 లేదా 10:30 ఖాళీ ఉంది. ఏది అనుకూలం?", lang: "te", delay: 2500 },
    { side: "right" as const, text: "10 o'clock fine. Ravi Kumar, 98765 43210", lang: "en", delay: 2000 },
  ];

  React.useEffect(() => {
    if (step >= conversation.length) {
      const timer = setTimeout(() => setStep(0), 6000);
      return () => clearTimeout(timer);
    }

    setIsSpeaking(conversation[step].side === "left");
    const timer = setTimeout(() => {
      setStep(s => s + 1);
    }, conversation[step].delay);

    return () => clearTimeout(timer);
  }, [step]);

  return (
    <div className="relative rounded-3xl border border-line bg-surface-raised p-6 shadow-lift ring-1 ring-brand-500/10">
      <div className="flex items-center justify-between pb-5 border-b border-line mb-6">
        <div className="flex items-center gap-2.5">
          <span className="relative flex h-2 w-2">
            <span className="absolute inline-flex h-full w-full animate-pulse-ring rounded-full bg-brand-600" />
            <span className="relative inline-flex h-2 w-2 rounded-full bg-brand-600" />
          </span>
          <span className="text-xs font-bold uppercase tracking-widest text-ink-subtle">Live Demo · 9:42 PM</span>
        </div>
        <span className="rounded-full bg-accent-amber/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest text-accent-amber ring-1 ring-inset ring-accent-amber/20">
          After Hours
        </span>
      </div>

      <div className="space-y-5 min-h-[320px] flex flex-col justify-end">
        {conversation.slice(0, step).map((msg, i) => (
          <Bubble key={i} side={msg.side} lang={msg.lang} text={msg.text} />
        ))}

        {isSpeaking && step < conversation.length && (
          <div className="flex justify-start items-center gap-3 animate-fade-in">
            <div className="flex items-end gap-1 h-5">
              {[1, 2, 3, 4, 5].map((i) => (
                <span
                  key={i}
                  className="w-0.5 bg-brand-500 rounded-full animate-wave"
                  style={{ animationDelay: `${i * 0.1}s`, height: `${Math.random() * 100 + 20}%` }}
                />
              ))}
            </div>
            <span className="text-xs italic text-ink-subtle animate-pulse">Maya is speaking...</span>
          </div>
        )}
      </div>

      {step === conversation.length && (
        <div className="mt la l la mt-8 animate-scale-in flex items-center gap-4 rounded-2xl border border-brand-600/20 bg-brand-500/10 p-5">
          <div className="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-brand-600 text-white shadow-glow">
            <Icon name="check" className="h-5 w-5" />
          </div>
          <div className="min-w-0">
            <span className="block text-[10px] font-bold uppercase tracking-wider text-brand-700">Appointment Booked</span>
            <span className="block text-sm font-semibold text-ink truncate">Dr Anitha · tomorrow, 10:00 AM</span>
          </div>
        </div>
      )}
    </div>
  );
}

function Bubble({ side, lang, text }: { side: "left" | "right"; lang?: string; text: string }) {
  const isRight = side === "right";
  return (
    <div className={cn("flex", isRight ? "justify-end" : "justify-start")}>
      <p
        lang={lang}
        className={cn(
          "max-w-[85%] rounded-2xl px-4 py-3 text-sm leading-relaxed animate-fade-up shadow-xs",
          lang === "te" ? "text-base leading-relaxed" : "",
          isRight
            ? "rounded-br-sm bg-brand-600 text-white font-medium"
            : "rounded-bl-sm bg-surface-sunken text-ink border border-line"
        )}
      >
        {text}
      </p>
    </div>
  );
}


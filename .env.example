# --- SAHVA -----------------------------------------------------------------
# Copy to .env and fill in. The API validates this on boot and refuses to start
# if anything is missing — see apps/api/src/config/env.ts.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Supabase --------------------------------------------------------------
# Project Settings -> API. Use a project in ap-south-1 (Mumbai): patient data
# for Indian clinics should not sit in another region, and every database round
# trip happens inside a ~1.2s voice turn budget.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# DANGER: bypasses Row Level Security completely. Server-side only.
# Never expose to a browser and never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web app (browser) -----------------------------------------------------
# These reach the browser bundle, so ONLY the anon key belongs here. The anon
# key is public by design; the service-role key must never appear below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE=http://localhost:4000

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Machine callers -------------------------------------------------------
# Shared secret for the telephony webhook and voice orchestrator, which carry
# no user JWT. At least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOICE_API_KEY=

# --- HTTP ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# --- ClinicVoice AI demo env ---
# Copy this file to .env (root) and fill in the values you have.

# Required: Anthropic API key for the conversation AI (claude-sonnet-4-6).
ANTHROPIC_API_KEY=

# Optional: ElevenLabs key. Reserved for later — the demo uses browser TTS by default.
ELEVENLABS_API_KEY=

# API server port (default 4000).
PORT=4000

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
